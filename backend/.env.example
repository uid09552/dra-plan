# Copy to .env for local development (never commit .env).
# Every setting can also be passed as a CLI argument; see `dra-server --help`.
DRA_DATABASE_URL=postgres://dra:dra@localhost:5434/dra
DRA_LISTEN_ADDR=127.0.0.1:8090
DRA_DEV_MODE=true
DRA_CORS_ORIGINS=http://localhost:4200
DRA_LOG_FORMAT=pretty
RUST_LOG=info,dra_server=debug
