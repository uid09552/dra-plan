# docker compose settings. Copy to `.env` and replace the secrets (`.env` is git-ignored).
# Generate secrets with: openssl rand -hex 24

# PostgreSQL superuser (the app uses role `dra`, Keycloak uses role `keycloak`)
POSTGRES_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me

# Keycloak admin console: http://localhost:9080/auth/admin (through APISIX)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_PUBLIC_URL=http://localhost:9080/auth
KEYCLOAK_REALM=dra
DRA_API_RESOURCE_ID=7f2f6f00-0000-4000-8000-000000000001

# Realm client of the application (UI login, API audience)
DRA_CLIENT_ID=dra-workflow
DRA_CLIENT_SECRET=change-me

# Realm client used by APISIX to validate tokens
APISIX_CLIENT_ID=apisix
APISIX_CLIENT_SECRET=change-me

# Browser login username: `demo-user` (not tenant alias `demo`), member of organization `demo`.
DEMO_USER_PASSWORD=change-me
# Optional: set a password for demo-admin; otherwise set it in the Keycloak admin console.
DEMO_ADMIN_PASSWORD=

# Browser URL of the UI (redirect URIs / web origins of the realm client)
UI_URL=http://localhost:4200

# Gateway (APISIX) upstreams. Defaults: the containers of `make app-up`.
# Backend on the host instead (`make run-gateway`): DRA_BACKEND_HOST=host.docker.internal
DRA_BACKEND_HOST=backend
DRA_BACKEND_PORT=8090
DRA_UI_HOST=ui
DRA_UI_PORT=8080

# Browser URL of the gateway; login callback is ${DRA_PUBLIC_URL}/oidc/callback
DRA_PUBLIC_URL=http://localhost:9080
# Encrypts APISIX's login session cookie (at least 32 characters)
APISIX_SESSION_SECRET=change-me-to-a-random-32-char-secret

# Containerized app: backend validates Keycloak JWTs by default. Set true only for local API mocking.
DRA_DEV_MODE=false
